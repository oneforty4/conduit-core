{
  "name": "@conduit-examples/sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run assets && pnpm run \"/^dev:(client|server)$/\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:host": "pnpm run assets && pnpm run \"/^dev:host:(client|server)$/\"",
    "dev:host:client": "vite --mode host",
    "dev:host:server": "tsx ../../packages/host/src/cli.ts ./src/server/game.ts",
    "assets": "conduit-assets build assets public/assets --graph world.json --clean && conduit-assets check public/assets/manifest.json",
    "world": "tsx scripts/export-world.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@conduit/assets": "workspace:*",
    "@conduit/game": "workspace:*",
    "@conduit/lobby-client": "workspace:*",
    "@conduit/math": "workspace:*",
    "@conduit/net-client": "workspace:*",
    "@conduit/protocol": "workspace:*",
    "@conduit/render": "workspace:*",
    "@conduit/sim": "workspace:*",
    "@conduit/world": "workspace:*",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@conduit/tooling": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "@types/three": "0.170.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.1.0",
    "vitest": "^3.1.0"
  }
}
