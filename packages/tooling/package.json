{
  "name": "@conduit/tooling",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "conduit-assets": "./bin/conduit-assets.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint.config.js",
    "./prettier": "./prettier.config.js",
    "./vitest": {
      "types": "./vitest.preset.ts",
      "default": "./vitest.preset.ts"
    },
    "./vite": {
      "types": "./vite.preset.ts",
      "default": "./vite.preset.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@conduit/assets": "workspace:*",
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.1.0",
    "vitest": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.1.0",
    "vitest": "^3.1.0"
  }
}
